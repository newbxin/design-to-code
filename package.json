{
  "name": "design-to-code",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:*",
    "dev:client": "npm --workspace client run dev",
    "dev:server": "npm --workspace server run dev",
    "test": "npm --workspaces --if-present test",
    "build": "npm --workspaces --if-present run build"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "rollup": "4.24.0"
  }
}
