        <mxCell id="e10" value="更新进度" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;endArrow=block;" edge="1" parent="1" source="tasksLoop" target="apply">
          <mxGeometry relative="1" as="geometry">
