        <mxCell id="e4" value="否：继续探索" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;entryX=0;entryY=0.5;endArrow=block;" edge="1" parent="1" source="ready" target="explore">
