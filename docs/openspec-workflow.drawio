        <mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;" edge="1" parent="1" source="artifacts" target="applyReady">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;" edge="1" parent="1" source="applyReady" target="apply">
          <mxGeometry relative="1" as="geometry" />
