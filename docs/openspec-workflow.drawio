        <mxCell id="e8" value="否：补齐缺失工件" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;entryX=0;entryY=0.5;endArrow=block;" edge="1" parent="1" source="applyReady" target="artifacts">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
